# ─────────────────────────────────────────────────────────────────────────────
# ANORA Labs — environment variables
#
# Copy this file to `.env.local` and fill in your own values:
#
#   cp .env.example .env.local
#
# Never commit real secrets. `.env` and `.env.*` are gitignored;
# `.env.example` is the only env file tracked by git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Convex (database, auth, real-time) ───────────────────────────────────────
# Run `npx convex dev` once to create a deployment, then copy the values here.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ── Google OAuth (sign-in) ───────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# and add the Convex site callback URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OpenRouter (all text / image / video models) ─────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Bunny.net — Storage + CDN (images and covers) ────────────────────────────
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_REGION=
# Hostname only or full URL, e.g. `your-zone.b-cdn.net`
BUNNY_PULL_ZONE_URL=

# ── Bunny.net — Stream (videos) ──────────────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# ── Polar.sh (billing & marketplace) ─────────────────────────────────────────
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
# A single ad-hoc-priced product reused for top-ups and marketplace purchases.
POLAR_PRODUCT_MARKETPLACE_ID=
POLAR_SUCCESS_URL=http://localhost:3000/checkout/topup/success?checkout_id={CHECKOUT_ID}

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Umami analytics (optional — omitted when unset) ──────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Defaults to https://cloud.umami.is/script.js when not provided.
NEXT_PUBLIC_UMAMI_SRC=
