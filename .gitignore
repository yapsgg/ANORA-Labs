# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# typescript
*.tsbuildinfo

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets. Copy .env.example to .env.local and fill in.
.env
.env.*
!.env.example

# vercel
.vercel

# turbo
.turbo

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# tooling — machine-specific local overrides
.claude/settings.local.json
